# Crow project memory. This file is safe to commit to a public repository.
# Provider endpoints and credentials remain in Raven or the private overlay.

spec_version: "1.0"

project:
  id: "raven"
  name: "Raven"
  repository:
    provider: "github"
    owner: "bcgov"
    name: "raven"
    visibility: "public"

sonar:
  projectKey: "RAVEN"
  projectName: "Raven"
  useMsBuild: false
  runTests: true

ci_cd:
  - id: "continuous-integration"
    provider: "github"
    repository:
      owner: "bcgov"
      name: "raven"
      visibility: "public"
    workflow_path: ".github/workflows/ci.yml"
    lookup:
      mode: "local-then-provider"
      connection_ref: "raven:github"
      resource_ref: "crow:ci:raven"
    discovered:
      source: "repository"
      recorded_by: "crow"
      recorded_on: "2026-09-15"

work_tracking:
  - id: "public-github-issues"
    provider: "github"
    repository:
      owner: "bcgov"
      name: "raven"
      visibility: "public"
    issue_source: "repository"
    lookup:
      mode: "local-then-provider"
      connection_ref: "raven:github"
      resource_ref: "crow:work-tracking:raven-issues"
    discovered:
      source: "user"
      recorded_by: "crow"
      recorded_on: "2026-09-15"

related_repositories:
  - id: "crow"
    provider: "github"
    owner: "bcgov"
    name: "crow"
    visibility: "public"
    relationship: "Agent and skill framework used with Raven"
    discovered:
      source: "user"
      recorded_by: "crow"
      recorded_on: "2026-09-15"

documentation:
  - id: "readme"
    source: "local"
    path: "README.md"
  - id: "system-design-and-architecture"
    source: "local"
    path: "docs/SYSTEM_DESIGN_AND_ARCHITECTURE.md"
  - id: "tool-inventory"
    source: "local"
    path: "docs/TOOL_INVENTORY.md"
  - id: "sonar-msbuild-workflow"
    source: "local"
    path: "docs/SONAR_MSBUILD_WORKFLOW.md"
  - id: "server-monitor-ui"
    source: "local"
    path: "SERVER_MONITOR_UI.md"
  - id: "autonomous-devops-pipeline"
    source: "local"
    path: "packages/pipeline/AUTONOMOUS_DEVOPS_PIPELINE.md"
  - id: "devops-pipeline-usage"
    source: "local"
    path: "packages/pipeline/DEVOPS_PIPELINE_USAGE.md"
  - id: "rfd-playbook"
    source: "local"
    path: "docs/RFD_PLAYBOOK.md"

memory_policy:
  visibility: "public-reference-only"
  private_overlay: "~/.crow/crow.config.local"
  allowed_values:
    - "provider names"
    - "public repository owner/name"
    - "repository-relative paths"
    - "workflow or pipeline names confirmed public"
    - "symbolic connection_ref and resource_ref names"
  forbidden_values:
    - "internal URLs or hostnames"
    - "credentials, tokens, passwords, or secret values"
    - "absolute local paths"
    - "provider response bodies"
  update_rule: "When a user supplies a resource URL, retain only a safe provider/repository/path descriptor or a symbolic resource_ref; keep the URL in Raven/provider storage or the private overlay."
