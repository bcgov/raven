# Crow project memory. This file is safe to commit to a public repository.
# Do not add internal URLs, credentials, tokens, passwords, absolute paths, or
# copied provider responses. Use the private reference names below instead.

spec_version: "1.0"

project:
  id: "raven"
  name: "RAVEN"
  description: "Resource Analytics, Visibility and Enterprise Navigator"
  repository:
    provider: "github"
    owner: "bcgov"
    name: "raven"
    visibility: "public"

# Sonar settings consumed by crow-sonar-scan.
#
# projectKey MUST be the uppercase "RAVEN". The server rejects a lowercase
# "raven" with "A similar key already exists: RAVEN", which fails the scan at
# the publish step after a full analysis has already run.
#
# The exclusions below are load-bearing, not cosmetic. The .claude/worktrees
# directory holds several full git worktrees of this repository (~2,400 .ts
# files against ~244 in the real source tree) and is not covered by .gitignore.
# Without the .claude exclusion a scan analyses extra copies of the codebase,
# inflating lines-of-code and making duplication metrics meaningless.
sonar:
  projectKey: "RAVEN"
  projectName: "Raven"
  exclusions:
    - "**/node_modules/**"
    - "**/dist/**"
    - "**/*.tsbuildinfo"
    - "**/.claude/**"
    - "**/.gstack/**"
    - "**/.scannerwork/**"
    - "**/coverage/**"
    - "**/build/**"
  useMsBuild: false
  runTests: false

# Evidence constraints for the security and dependency review agent.
#
# SonarQube SCA (dependency analysis) is NOT enabled on the server used by this
# project; scanner logs report "Dependency analysis skipped". Per Crow's CVE
# provenance rules, dependency risk assessments for this repository must be
# tagged [AI-estimated - verify with a dependency scanner] and must never be
# tagged [SonarQube]. Use npm audit as the evidence source for the CVE table.
analysis_notes:
  sonar_sca_enabled: false
  dependency_evidence_command: "npm audit --json"
  coverage_provider_installed: false
  coverage_note: "No coverage provider is installed, so a Sonar run reports 0% regardless of runTests."

ci_cd:
  - id: "continuous-integration"
    provider: "github"
    repository:
      owner: "bcgov"
      name: "raven"
      visibility: "public"
    workflow_path: ".github/workflows/ci.yml"
    lookup:
      mode: "local-then-provider"
      connection_ref: "raven:github"
      resource_ref: "crow:ci:raven"
    discovered:
      source: "repository"
      recorded_by: "crow"
      recorded_on: "2026-09-15"
  - id: "release-draft"
    provider: "github"
    repository:
      owner: "bcgov"
      name: "raven"
      visibility: "public"
    workflow_path: ".github/workflows/release-draft.yml"
    lookup:
      mode: "local-then-provider"
      connection_ref: "raven:github"
      resource_ref: "crow:ci:raven-release-draft"
    discovered:
      source: "repository"
      recorded_by: "crow"
      recorded_on: "2026-09-21"

work_tracking:
  - id: "public-github-issues"
    provider: "github"
    repository:
      owner: "bcgov"
      name: "raven"
      visibility: "public"
    issue_source: "repository"
    lookup:
      mode: "local-then-provider"
      connection_ref: "raven:github"
      resource_ref: "crow:work-tracking:raven-issues"
    discovered:
      source: "user"
      recorded_by: "crow"
      recorded_on: "2026-09-15"

related_repositories:
  - id: "crow"
    provider: "github"
    owner: "bcgov"
    name: "crow"
    visibility: "public"
    relationship: "Agent and skill framework used with Raven"
    discovered:
      source: "user"
      recorded_by: "crow"
      recorded_on: "2026-09-15"

documentation:
  - id: "readme"
    source: "local"
    path: "README.md"
  - id: "system-design-and-architecture"
    source: "local"
    path: "docs/SYSTEM_DESIGN_AND_ARCHITECTURE.md"
  - id: "tool-inventory"
    source: "local"
    path: "docs/TOOL_INVENTORY.md"
  - id: "sonar-msbuild-workflow"
    source: "local"
    path: "docs/SONAR_MSBUILD_WORKFLOW.md"
  - id: "server-monitor-ui"
    source: "local"
    path: "SERVER_MONITOR_UI.md"
  - id: "autonomous-devops-pipeline"
    source: "local"
    path: "packages/pipeline/AUTONOMOUS_DEVOPS_PIPELINE.md"
  - id: "devops-pipeline-usage"
    source: "local"
    path: "packages/pipeline/DEVOPS_PIPELINE_USAGE.md"
  - id: "rfd-playbook"
    source: "local"
    path: "docs/RFD_PLAYBOOK.md"

memory_policy:
  visibility: "public-reference-only"
  private_overlay: "~/.crow/crow.config.local"
  allowed_values:
    - "provider names"
    - "public repository owner/name"
    - "repository-relative paths"
    - "workflow or pipeline names confirmed public"
    - "symbolic connection_ref and resource_ref names"
  forbidden_values:
    - "internal URLs or hostnames"
    - "credentials, tokens, passwords, or secret values"
    - "absolute local paths"
    - "provider response bodies"
  update_rule: "When a user supplies a resource URL, retain only a safe provider/repository/path descriptor or a symbolic resource_ref; keep the URL in Raven/provider storage or the private overlay."
